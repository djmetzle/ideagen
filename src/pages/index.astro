---
import '../styles/pico.scss'

import IdeaGen from '../components/IdeaGen.vue'

const today = new Date();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
		<style lang="scss" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content="Photo Idea Generator" />
		<!-- Site metadata (org, 2026-11-21): the manifest, the touch icon, the canonical and the share image. -->
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#ffffff" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The djmetzle pixel mark and the name ideagen, in teal on white." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />
		<meta name="twitter:image:alt" content="The djmetzle pixel mark and the name ideagen, in teal on white." />
		<title>Photo Idea Generator</title>
	</head>
	<body>
		<header class="container">
			<hgroup>
				<h1>📸 Photo Idea Generator</h1>
			</hgroup>
			<hr/>
		</header>

		<main class="container">
			<IdeaGen client:only="vue" />
		</main>

		<footer class="container">
			<p>&copy; {today.getFullYear()} <a href="https://www.djmetzle.io">djmetzle</a> All rights reserved.</p>
		</footer>
	</body>
</html>
